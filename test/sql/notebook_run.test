# The caller's max_execution_time bounds the whole call: every query the notebook's connection starts ends by the
# call's deadline, and the call fails once it has passed, whichever cell ran out of time. The notebooks are written
# first, so that only the calls run under the limit. Each slow cell alone takes far longer than the limit (about a
# second): these check that the deadline holds and how the call ends, not how time is shared between queries, which
# no test here could time reliably
statement ok
COPY (SELECT '-- %% slow' || chr(10) || 'SELECT sum(a.range * b.range) FROM range(100000) a, range(100000) b;' || chr(10)) TO '__TEST_DIR__/nb_slow.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
COPY (SELECT '-- %% slow' || chr(10) || 'SELECT sum(a.range * b.range) FROM range(100000) a, range(100000) b;' || chr(10) || chr(10) || '-- %% slower' || chr(10) || 'SELECT sum(a.range + b.range) FROM range(100000) a, range(100000) b;' || chr(10)) TO '__TEST_DIR__/nb_slow2.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
COPY (SELECT '-- %%' || chr(10) || 'SET max_execution_time = 0;' || chr(10) || chr(10) || '-- %% slow' || chr(10) || 'SELECT sum(a.range * b.range) FROM range(100000) a, range(100000) b;' || chr(10)) TO '__TEST_DIR__/nb_slow_unset.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
COPY (SELECT '-- %% slow' || chr(10) || 'SET max_execution_time = 0;' || chr(10) || 'SELECT sum(a.range * b.range) FROM range(100000) a, range(100000) b;' || chr(10)) TO '__TEST_DIR__/nb_slow_same.sql' (FORMAT csv, HEADER false, QUOTE '')

statement ok
SET max_execution_time = 200

# The last (here the only) cell running out of time fails the call too
statement error
FROM notebook_run('__TEST_DIR__/nb_slow.sql')
----
maximum execution time

statement error
FROM notebook_run('__TEST_DIR__/nb_slow2.sql')
----
maximum execution time

# A cell's own SET max_execution_time = 0 does not lift the call's deadline, in a cell before or in the same cell
statement error
FROM notebook_run('__TEST_DIR__/nb_slow_unset.sql')
----
maximum execution time

statement error
FROM notebook_run('__TEST_DIR__/nb_slow_same.sql')
----
maximum execution time

# Exports run the notebook too, under the same limit, and write nothing: no page, no data directory
statement error
FROM notebook_export('__TEST_DIR__/nb_slow2.sql', file := '__TEST_DIR__/nb_slow2.html')
----
maximum execution time

statement error
FROM notebook_export('__TEST_DIR__/nb_slow.sql', file := '__TEST_DIR__/nb_slow.html')
----
maximum execution time

statement error
FROM notebook_export('__TEST_DIR__/nb_slow.sql', file := '__TEST_DIR__/nb_slow_data', format := 'data')
----
maximum execution time

statement ok
RESET max_execution_time

query I
SELECT count(*) FROM glob('__TEST_DIR__/nb_slow*.html')
----
0

# The data directory was never made: a file cannot be written into it
statement error
COPY (SELECT 1 AS x) TO '__TEST_DIR__/nb_slow_data/probe.csv'
----
nb_slow_data

# A {{ }} expression may end in a line comment, before the }} on the next line
statement ok
COPY (SELECT '-- %% [markdown]' || chr(10) || '/* Total: {{ 40 + 2 -- the answer' || chr(10) || '}} */' || chr(10)) TO '__TEST_DIR__/nb_md_comment.sql' (FORMAT csv, HEADER false, QUOTE '')

query II
SELECT status, trim(output) FROM notebook_run('__TEST_DIR__/nb_md_comment.sql')
----
ok	Total: 42
