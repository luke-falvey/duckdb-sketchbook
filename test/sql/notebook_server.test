# name: test/sql/notebook_server.test
# description: notebook_start and notebook_stop run the HTTP server on 127.0.0.1
# group: [sql]

require sketchbook

query II
SELECT url LIKE 'http://127.0.0.1:%/?token=%&nb=test%2Fnotebooks%2Fbasic.sql&db=memory', length(token) FROM notebook_start('test/notebooks/basic.sql', open := false)
----
true	32

# Starting again reuses the running server
query I
SELECT count(DISTINCT port) FROM (FROM notebook_start(open := false) UNION ALL FROM notebook_start(open := false))
----
1

query I
FROM notebook_stop()
----
true

query I
FROM notebook_stop()
----
false
