# name: test/sql/notebook_run.test
# description: notebook_run executes every cell in a session of its own
# group: [sql]

require sketchbook

query IIIIII
SELECT idx, kind, name, status, error, row_count FROM notebook_run('test/notebooks/basic.sql') ORDER BY idx
----
0	notebook	NULL	skipped	NULL	NULL
1	markdown	NULL	skipped	NULL	NULL
2	sql	numbers	ok	NULL	NULL
3	input	lowest	ok	NULL	NULL
4	sql	kept	ok	NULL	6
5	sql	by_group	ok	NULL	3
6	chart	NULL	ok	NULL	3
7	sql	picked_rows	ok	NULL	6
8	sql	NULL	ok	NULL	1

# Tables a notebook creates are real and remain
query I
SELECT count(*) FROM nb_test_numbers
----
10

# Its views and variables belong to the run's own session and do not leak into the caller's
statement error
SELECT * FROM kept
----
Table with name kept does not exist

query I
SELECT getvariable('lowest')
----
NULL

# A failing cell is reported and the run continues; cells that depend on it fail on their own terms
query III
SELECT name, status, error LIKE '%table_that_does_not_exist%' FROM notebook_run('test/notebooks/failing.sql') ORDER BY idx
----
good	ok	NULL
broken	error	true
after	ok	NULL

statement error
SELECT * FROM notebook_run('test/notebooks/errors.sql')
----
Notebook "test/notebooks/errors.sql" has errors

# Graph errors stop a run too
statement error
SELECT * FROM notebook_run('test/notebooks/graph_errors.sql')
----
'later' is defined further down, at line 5

# params override input defaults and set selection variables
query II
SELECT name, row_count FROM notebook_run('test/notebooks/basic.sql', params := {lowest: 8, picked: [2]}) WHERE name IN ('kept', 'picked_rows') ORDER BY idx
----
kept	2
picked_rows	1

statement error
SELECT * FROM notebook_run('test/notebooks/basic.sql', params := {nope: 1})
----
the notebook has no input or variable named 'nope'

statement error
SELECT * FROM notebook_run('test/notebooks/basic.sql', params := 5)
----
params must be a struct

# Markdown {{ }} expressions are evaluated once the cells they read have run, so a
# markdown cell may sit above them; rows come in run order
query IIII
SELECT idx, status, replace(output, chr(10), ' / '), error LIKE '%no_such_table_here%' FROM notebook_run('test/notebooks/markdown.sql')
----
1	ok	NULL	NULL
2	ok	NULL	NULL
0	ok	Total 3 at level 3; braces in }} are fine.	NULL
3	skipped	No expressions here.	NULL
4	error	NULL	true

query I
SELECT output FROM notebook_run('test/notebooks/markdown.sql', params := {level: 5}) WHERE idx = 0
----
Total 10 at level 5; braces in }} are fine.

# The example notebooks run end to end, charts included
query I
SELECT count(*) FROM notebook_run('examples/revenue.sql') WHERE status = 'error'
----
0

query II
SELECT count(*) FILTER (status = 'error'), count(*) FILTER (kind = 'chart' AND status = 'ok') FROM notebook_run('examples/charts.sql')
----
0	29

# So does the template every new sketchbook starts from (it creates orders, dropped below)
query I
SELECT count(*) FROM notebook_run('.github/skills/sketchbook-authoring/assets/template.sql') WHERE status = 'error'
----
0

# The [notebook] cell's attach: databases are attached before the first cell
query II
SELECT name, row_count FROM notebook_run('test/notebooks/metadata.sql') WHERE name IS NOT NULL
----
from_attached	1

# and detached when the run is over
query I
SELECT count(*) FROM duckdb_databases() WHERE database_name = 'nb_meta_db'
----
0

# A database already attached under that name is used if it is the same one, and left attached
statement ok
ATTACH ':memory:' AS nb_meta_db

query II
SELECT name, row_count FROM notebook_run('test/notebooks/metadata.sql') WHERE name IS NOT NULL
----
from_attached	1

query I
SELECT v FROM nb_meta_db.t
----
7

statement ok
DETACH nb_meta_db

# but a different database under that name is an error, not silently used
statement ok
ATTACH '__TEST_DIR__/nb_meta_other.db' AS nb_meta_db

statement error
SELECT * FROM notebook_run('test/notebooks/metadata.sql')
----
the [notebook] cell attaches ':memory:' as nb_meta_db, but nb_meta_db is already attached to

statement ok
DETACH nb_meta_db

# and so is the same database in another mode (the file is next to the notebook, as its attach: says)
statement ok
ATTACH 'test/notebooks/nb_meta_mode.duckdb' AS nb_meta_mode

statement ok
DETACH nb_meta_mode

statement ok
ATTACH 'test/notebooks/nb_meta_mode.duckdb' AS nb_meta_mode (READ_ONLY)

statement error
SELECT * FROM notebook_run('test/notebooks/attach_mode.sql')
----
the [notebook] cell attaches 'test/notebooks/nb_meta_mode.duckdb' as nb_meta_mode, but nb_meta_mode is already attached read-only

statement ok
DETACH nb_meta_mode

# DECIMAL values are exact, and doubles have the fewest digits that read back as the same value
statement ok
FROM notebook_export('test/notebooks/numbers.sql', file := '__TEST_DIR__/numbers.md', format := 'md')

query I
SELECT content LIKE '%| 268.18 | 268.18 | 12345678901234567.89 | 0.1 | 0.30000000000000004 | Infinity | -Infinity | NaN |%' FROM read_text('__TEST_DIR__/numbers.md')
----
true

